{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {"@/*": ["src/*"], "@umijs/max": ["src/.umi/exports.ts"]}
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", ".umi", "dist"]
}
